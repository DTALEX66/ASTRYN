# 统一行尾：仓库内一律 LF。
# 必要性：tests/boundary/design-tokens.test.ts 等用多行正则解析 astryn.css 与 state-visuals.ts，
# Windows 克隆若落成 CRLF 会让锚点匹配失败（本机 core.autocrlf 为 true 时必现）。
* text=auto eol=lf

# 明确不转换的二进制类
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.glb binary
*.vrm binary
*.zip binary
*.gz binary
*.safetensors binary
*.gguf binary
*.onnx binary

# 文档与代码保持 LF
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf

# 若将来引入 Windows 脚本，必须 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
