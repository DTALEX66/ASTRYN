# 星栖开发宿主配置示例。复制为 .env 后按需填写；.env 不会被提交。
# 这里只允许出现非机密变量：模型密钥只能放在 dev 代理进程的环境里。

# --- 浏览器侧（Vite 只暴露 VITE_ 前缀，且这些值会进入前端包）---
# AAOS Core 的 loopback 地址；留空即视为宿主不可连接，星栖不猜测现场。
VITE_ASTRYN_AAOS_BASE_URL=
# 置 1 表示开发代理已配置好上游模型（浏览器仍不知道密钥）。
VITE_ASTRYN_DEV_PROXY_ENABLED=0
# 供请求使用的模型标识，不是密钥。
VITE_ASTRYN_DEV_MODEL=
# 置 1 才允许使用明确标注 SYNTHETIC 的合成回复；默认关闭，绝不用脚本冒充 AI。
VITE_ASTRYN_ALLOW_SYNTHETIC=0
# 置 1 启用合成宿主模拟器，用于演示审批/执行/完成这条权威回执链路。
VITE_ASTRYN_SYNTHETIC_HOST=0

# --- 仅 dev 代理进程使用（不会进入浏览器包，不要提交真实值）---
# 注意：npm run dev:proxy 不会自动加载本文件，请在 shell 中 export 以下变量，
# 或改用：node --env-file-if-exists=.env dev-host/server/dev-model-proxy.mjs（需 Node ≥22.9）。
# ASTRYN_DEV_MODEL_BASE_URL=https://api.<your-provider>/v1
# ASTRYN_DEV_MODEL_API_KEY=
# ASTRYN_DEV_MODEL=
# ASTRYN_DEV_PROXY_PORT=8791
# ASTRYN_DEV_MODEL_TIMEOUT_MS=30000

# --- 本地端口 ---
# ASTRYN_DEV_HOST_PORT=5183
